{
  "name": "share-text",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "heartbeat": "node scripts/heartbeat.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo && node scripts/check-scripts.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "node scripts/run-e2e.mjs",
    "format": "prettier --write '**/*.{js,ts,svelte}'",
    "env:sync:vercel": "node ./scripts/sync-vercel-env.mjs",
    "env:sync:cloudflare": "node ./scripts/sync-cloudflare-env.mjs",
    "schema:apply": "node ./scripts/apply-schema.mjs",
    "schema:recreate": "node ./scripts/recreate-schema.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@codepg/ui-lib": "^0.4.2",
    "@neondatabase/serverless": "^1.2.1",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "better-sqlite3": "^13.2.0",
    "diff": "^9.0.0",
    "marked": "^18.2.1",
    "papaparse": "^5.7.1",
    "svelte-sonner": "^1.2.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/adapter-vercel": "^7.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/svelte": "^5.4.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "dotenv": "^18.0.10",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "glob": "^14.0.3"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild@0.28.2": true,
    "fsevents": true,
    "workerd": true
  }
}
