# Profile selects the database backend.
# dev  - local SQLite (auto-created, no DATABASE_URL needed).
# prod - PostgreSQL/Neon via DATABASE_URL (used on Vercel).
PROFILE=dev

# Public URL the app is reachable at. Override in .env.vercel for production.
APP_BASE_URL=http://localhost:5173

# Local SQLite database file (dev profile). Default: .data/share-text-dev.sqlite
# SQLITE_PATH=.data/share-text-dev.sqlite

# PostgreSQL connection string (Neon in production). Required only for PROFILE=prod.
DATABASE_URL=postgres://user:password@localhost:5432/share_text

# PostgreSQL schema name for table isolation (production). Default: public
# SCHEMA_NAME=share-doc

# Maximum number of documents an IP can create (created_by == IP). Default: 10.
# MAX_DOCUMENTS_PER_IP=10

# Maximum length (in characters) of document content allowed in the editor and
# from uploaded files. Default: 1048576 (1 MB worth of characters).
# MAX_CONTENT_LENGTH=1048576

# Maximum number of content versions kept per document. A version is recorded
# on every save that changes the content or the document type; older versions
# beyond this count are pruned. Default: 20.
# MAX_DOCUMENT_VERSIONS=20

# Admin credentials for the settings dialog (gear icon in the left pane).
# In production set ADMIN_PASSWORD_HASH (generated with
# `node scripts/hash-password.mjs <password>`) instead of a plain password.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=

# Secret used to sign the admin session cookie. Required in production.
# SESSION_SECRET=

# Optional label for the current worktree's changes, shown in a sticky block at
# the bottom left of the browser. Set it in the local .env.dev of a feature
# worktree to mark which worktree's changes you are viewing (e.g.
# DEV_TAG=feat/copy-share-link). Ignored when unset.
# DEV_TAG=
